FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY tempo_fechado/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY tempo_fechado/ /app/

ENV TEMPO_FECHADO_MODO_SERVIDOR=1 \
    TEMPO_FECHADO_PONTO_PDFS_DIR=/app/ponto_pdfs \
    TEMPO_FECHADO_HOST=0.0.0.0 \
    TEMPO_FECHADO_PORT=5050 \
    PYTHONUNBUFFERED=1

EXPOSE 5050

CMD ["waitress-serve", "--host=0.0.0.0", "--port=5050", "--threads=8", "robo_ponto_web:app"]
