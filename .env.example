# ============================================================
# Rubble — Environment Configuration
# ============================================================
# Local (USBWebserver): DB_HOST=localhost
# Docker Compose:       DB_HOST=db
# ============================================================

DB_HOST=localhost
DB_NAME=manutencao
DB_USER=
DB_PASS=

# Required only for Docker Compose (mariadb root password)
# DB_ROOT_PASSWORD=

# Let's Encrypt registration email (Docker only, used in docker-compose.yml)
LE_EMAIL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Rubble
# Hostname usado no Message-ID e HELO (se vazio, deriva do domínio de SMTP_FROM_EMAIL)
#SMTP_HOSTNAME=engemon.com.br

NOTIFY_EMAILS=

# PV Email — destinatários Para (To)
#PV_EMAILS_ES=
#PV_EMAILS_RJ=
# PV Email — destinatários em Cópia (Cc)
#PV_EMAILS_ES_CC=
#PV_EMAILS_RJ_CC=

# Cloudflare Turnstile (login protection — leave empty to skip in dev)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# IMAP — Email approval watcher (check_pv_approval.php)
# Em produção (VPS) o watcher lê a caixa de aprovação via IMAP.
# Gmail: senha de app obrigatória (Conta Google -> Segurança -> Senhas de app; exige 2FA).
# IMAP_SECURITY=ssl (default) para provedores externos (ex: Gmail, porta 993).
#IMAP_HOST=imap.gmail.com
#IMAP_PORT=993
#IMAP_USER=rubbleaprovacoes@gmail.com
#IMAP_PASS=<senha de app do Gmail>
#IMAP_MAILBOX=INBOX
#IMAP_SECURITY=ssl

# PV Email — Reply-To: direciona respostas de aprovação para a caixa Gmail
#PV_REPLY_TO=rubbleaprovacoes@gmail.com

JWT_SECRET=<64-char-random-hex>
# Tempo Fechado: secret da sessão Flask (deve ser igual ao JWT_SECRET para SSO) — gere com: openssl rand -hex 32
# TEMPO_FECHADO_SECRET_KEY=${JWT_SECRET}
# JWT compartilhado Rubble ↔ Tempo Fechado (docker-compose injeta TEMPO_FECHADO_JWT_SECRET=${JWT_SECRET})
# TEMPO_FECHADO_JWT_SECRET=${JWT_SECRET}
# Tempo Fechado roda como service separado tempo-fechado:5050 atrás do nginx em /tempo-fechado/
# TEMPO_FECHADO_MODO_SERVIDOR=1
# Opcional: usuários iniciais do Tempo Fechado (JSON) — se vazio nenhum usuário padrão é criado
# TEMPO_FECHADO_DEFAULT_USERS_JSON='{"admin":{"senha":"trocar123","nome":"Administrador","perfil":"admin","trocar_senha":1}}'

APP_DEBUG=false
# Local (USBWebserver): ALLOWED_ORIGINS=* (APP_DEBUG=true aceita wildcard)
# Docker/Produção:      ALLOWED_ORIGINS=https://rubbleapp.duckdns.org (APP_DEBUG=false rejeita *)
ALLOWED_ORIGINS=*
