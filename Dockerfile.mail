FROM alpine:3.20

RUN apk add --no-cache postfix dovecot \
    && mkdir -p /var/mail/vhosts /var/log/postfix \
    && chown -R 5000:5000 /var/mail/vhosts

COPY config/mail/main.cf /etc/postfix/main.cf
COPY config/mail/dovecot.conf /etc/dovecot/dovecot.conf
COPY config/mail/entrypoint.sh /entrypoint.sh

RUN chmod +x /entrypoint.sh

EXPOSE 25

ENTRYPOINT ["/entrypoint.sh"]
